{
  "name": "@fantastic.dev/convex-tinybird",
  "version": "0.2.6",
  "type": "module",
  "sideEffects": false,
  "description": "Reusable Convex component for shipping analytics events to Tinybird, independent of any host application's schema, auth or packages.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FantasticDevHQ/convex-tinybird.git"
  },
  "homepage": "https://github.com/FantasticDevHQ/convex-tinybird#readme",
  "bugs": {
    "url": "https://github.com/FantasticDevHQ/convex-tinybird/issues"
  },
  "keywords": [
    "convex",
    "convex-component",
    "tinybird",
    "analytics",
    "outbox"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24.22.1"
  },
  "exports": {
    ".": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "default": "./dist/browser/index.js"
    },
    "./convex.config": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    },
    "./convex.config.js": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    },
    "./test": "./src/test.ts",
    "./_generated/component.js": {
      "types": "./dist/component/_generated/component.d.ts"
    }
  },
  "scripts": {
    "check:boundary": "node scripts/check-boundary.mjs",
    "check:secrets": "node scripts/check-no-secrets.mjs",
    "codegen": "convex codegen --component-dir src/component",
    "test": "vitest run --maxWorkers=1",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run test:standard && pnpm run check:pack && node --test --test-concurrency=1 scripts/check-pack.test.mjs && pnpm run typecheck && pnpm run test && pnpm run check:boundary && pnpm run check:secrets && node scripts/check-codegen-fresh.mjs && node scripts/check-readme-samples.mjs && node --test --test-concurrency=1 scripts/check-boundary.test.mjs scripts/check-no-secrets.test.mjs scripts/check-codegen-fresh.test.mjs scripts/check-readme-samples.test.mjs scripts/release-notes.test.mjs && pnpm --dir example run typecheck && pnpm --dir example run test",
    "build": "tsc --project tsconfig.build.json",
    "check:pack": "pnpm run build && node scripts/check-pack.mjs",
    "prepack": "pnpm run build",
    "prepare": "pnpm run build",
    "worktree:setup": "node scripts/worktree/cli.mjs setup",
    "worktree:start": "node scripts/worktree/cli.mjs start",
    "worktree:stop": "node scripts/worktree/cli.mjs stop",
    "worktree:teardown": "node scripts/worktree/cli.mjs teardown",
    "worktree:cleanup": "node scripts/worktree/cli.mjs cleanup",
    "worktree:prune": "node scripts/worktree/cli.mjs prune",
    "test:standard": "node --test --test-concurrency=1 scripts/pr-standard.test.mjs scripts/enforce-pr-standard.test.mjs scripts/worktree/*.test.mjs",
    "test:worktree:integration": "node --test --test-concurrency=1 scripts/worktree/worktree.integration.mjs"
  },
  "peerDependencies": {
    "convex": "^1.44.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "convex": "^1.46.0",
    "convex-test": "^0.0.60",
    "vite": "8.3.1",
    "vitest": "^5.0.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@convex-dev/workpool": "0.4.12"
  },
  "license": "Apache-2.0",
  "files": [
    "dist",
    "src",
    "docs",
    "CHANGELOG.md"
  ],
  "types": "./dist/client/index.d.ts",
  "module": "./dist/client/index.js"
}
