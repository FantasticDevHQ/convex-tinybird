{
  "name": "@fantasticdevhq/convex-tinybird-example",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Minimal Convex app that mounts two named instances of the Tinybird component, plus a small Vite page that shows the metrics it tracks. Exists to prove the component is portable: the backend depends on convex and the component and nothing else.",
  "scripts": {
    "codegen": "CONVEX_AGENT_MODE=anonymous convex dev --once",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fantasticdevhq/convex-tinybird": "workspace:*",
    "convex": "^1.44.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.10.11",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "convex-test": "^0.0.55",
    "vite": "8.2.1",
    "vitest": "^4.1.10"
  }
}
