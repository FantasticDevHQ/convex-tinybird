{
  "name": "@fantastic.dev/convex-tinybird-example",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Minimal Convex app that mounts two named instances of the Tinybird component, plus a small Vite page that shows the metrics it tracks. Exists to prove the component is portable: the backend depends on convex and the component and nothing else.",
  "scripts": {
    "codegen": "CONVEX_AGENT_MODE=anonymous convex dev --once",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fantastic.dev/convex-tinybird": "workspace:*",
    "@fontsource-variable/geist": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "convex": "^1.46.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "convex-test": "^0.0.60",
    "tailwindcss": "^4.3.3",
    "vite": "8.3.1",
    "vitest": "^5.0.1"
  }
}
