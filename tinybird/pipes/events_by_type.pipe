# Count each event_id once before aggregating, even before background merges.
# FINAL has a query-time cost; hosts should choose an appropriate time window.

TOKEN "events_read" READ

NODE counts
SQL >
    %
    SELECT
        event_type,
        count() AS events
    FROM events FINAL
    WHERE occurred_at >= {{DateTime64(start, '2000-01-01 00:00:00.000')}}
      AND occurred_at < {{DateTime64(end, '2100-01-01 00:00:00.000')}}
    GROUP BY event_type
    ORDER BY events DESC, event_type ASC
    LIMIT least(greatest({{Int32(limit, 100)}}, 1), 1000)

TYPE endpoint
